<?xml version="1.0" encoding="utf-8"?>
<!-- Night surface: same shape language as the day card, kept slightly
     translucent so the wallpaper still shows through, with a light rim so the
     card has an edge against dark wallpapers. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F52A3050"
        android:centerColor="#F21C2138"
        android:endColor="#F0121523"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
