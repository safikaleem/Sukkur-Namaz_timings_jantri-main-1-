<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_tiny"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Clock, then city: stacked and centred so neither can overlap. -->
    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#1A1A2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:format12Hour="h:mm a"
        android:format24Hour="HH:mm" />

    <TextView
        android:id="@+id/widget_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sukkur"
        android:textColor="#888899"
        android:textSize="8sp"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

    <TextView
        android:id="@+id/tiny_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Isha"
        android:textColor="#1A1A2E"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

    <Chronometer
        android:id="@+id/tiny_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6A817"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:textDirection="ltr"
        android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

</LinearLayout>

</FrameLayout>
