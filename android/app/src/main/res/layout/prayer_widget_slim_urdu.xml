<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_slim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Accent rule: anchors the row and picks up the countdown colour. -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="3dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_accent_bar"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp" />

        <!-- Left Column: Location, Prayer Name, Label -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">
            <!-- No pin, bounded to its own column so a long city name can
                 never run under the times on the right. -->
            <TextView
                android:id="@+id/widget_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sukkur"
                android:textColor="#888899"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <TextView
                android:id="@+id/slim_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textColor="#1A1A2E"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <TextView
                android:id="@+id/slim_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="until Isha"
                android:textColor="#888899"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Column: Prayer Time, Countdown. No clock - the phone's own
             clock sits on the same home screen. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/slim_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:52 PM"
                android:textColor="#1A1A2E"
                android:textSize="19sp"
                android:textStyle="bold"
                android:gravity="end"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <Chronometer
                android:id="@+id/slim_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6A817"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:gravity="end"
                android:layout_gravity="end"
                android:layout_marginTop="3dp"
                android:textDirection="ltr"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
