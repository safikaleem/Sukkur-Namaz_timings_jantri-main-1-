                android:gravity="center"
                android:textSize="10sp"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginTop="-3dp" />

            <Chronometer
                android:id="@+id/cd_l_zuhar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textColor="#E6A817"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="-2dp"
                android:textDirection="ltr" />
        </LinearLayout>

        <!-- Misl Awwal -->
        <LinearLayout
            android:id="@+id/box_l_misl"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_box_inactive"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_margin="2dp">

            <ImageView
                android:id="@+id/dot_l_misl"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/dot_inactive"
                android:layout_marginBottom="1dp" />

            <TextView
                android:id="@+id/lbl_l_misl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Misl Awwal"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textColor="#555577"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <TextView
                android:id="@+id/widget_l_misl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginTop="-3dp" />

            <Chronometer
                android:id="@+id/cd_l_misl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textColor="#E6A817"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="-2dp"
                android:textDirection="ltr" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/box_l_asr"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_box_inactive"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_margin="2dp">

            <ImageView
                android:id="@+id/dot_l_asr"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/dot_inactive"
                android:layout_marginBottom="1dp" />

            <TextView
                android:id="@+id/lbl_l_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textColor="#555577"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <TextView
                android:id="@+id/widget_l_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="#1A1A2E"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_marginTop="-3dp" />

            <Chronometer
                android:id="@+id/cd_l_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9.5sp"
                android:textColor="#E6A817"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="-2dp"
                android:textDirection="ltr" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/box_l_maghrib"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/widget_box_inactive"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_margin="2dp">

            <ImageView
                android:id="@+id/dot_l_maghrib"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:src="@drawable/dot_inactive"
                android:layout_marginBottom="1dp" />

            <TextView
                android:id="@+id/lbl_l_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textColor="#555577"
                android:textStyle="bold"
                android:lines="1"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:fontFamily="@font/jameel_noori_nastaleeq_kasheeda" />

            <TextView
                android:id="@+id/widget_l_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:gravity="center"
                android:textSize="10sp"
                android:textColor="#1A1A2E"
