<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp">

    <!-- No clock: the widget is about the next prayer, and the phone's own
         clock is on the same home screen. -->
    <TextView
        android:id="@+id/widget_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sukkur"
        android:textColor="#888899"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.07"
        android:gravity="center"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="8dp" />

    <!-- Prayer Name e.g. "Zawal", "Isha" -->
    <TextView
        android:id="@+id/widget_prayer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fajr"
        android:textColor="#1A1A2E"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <!-- Actual Prayer Time e.g. "12:24 PM" -->
    <TextView
        android:id="@+id/widget_prayer_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--:-- AM"
        android:textColor="#1A1A2E"
        android:textSize="27sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:layout_marginTop="3dp" />

    <!-- Countdown e.g. "+2:32" or "-27:51" -->
    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6A817"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/widget_pill"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_marginTop="7dp"
        android:textDirection="ltr" />

    <!-- Divider -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="1dp"
        android:background="#22000000"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal" />



</LinearLayout>

</FrameLayout>
