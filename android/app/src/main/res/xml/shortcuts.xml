<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="qibla"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_qibla"
        android:shortcutShortLabel="@string/shortcut_qibla_short"
        android:shortcutLongLabel="@string/shortcut_qibla_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="pk.sukkur.salah"
            android:targetClass="pk.sukkur.salah.MainActivity"
            android:data="sukkursalah://shortcut?action=qibla">
            <extra
                android:name="shortcut_action"
                android:value="qibla" />
        </intent>
        <capability android:name="actions.intent.OPEN_APP_FEATURE" />
    </shortcut>

